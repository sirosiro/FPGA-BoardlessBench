{
  "name": "fbb-plugin-winbond-w25q128",
  "vendor": "Winbond",
  "version": "1.0.0",
  "description": "F-BB Virtual Peripheral Emulator for W25Q128 SPI NOR Flash",
  "peripherals": [
    {
      "bus": "spi",
      "compatible": "winbond,w25q128",
      "binary": "fbb_spi_flash",
      "default_args": [
        "--socket", "{socket_path}",
        "--file", "{mock_file}"
      ],
      "ui_widget": {
        "title": "Winbond W25Q128 SPI Flash",
        "controls": [
          { "type": "status", "name": "capacity", "label": "16MB SPI Flash" }
        ]
      }
    }
  ]
}
