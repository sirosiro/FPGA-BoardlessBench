{
  "name": "fbb-plugin-solomon-ssd1306",
  "vendor": "Solomon Systech",
  "version": "1.0.0",
  "description": "F-BB Virtual Peripheral Emulator for SSD1306 128x64 I2C OLED Display",
  "peripherals": [
    {
      "bus": "i2c",
      "compatible": "solomon,ssd1306",
      "binary": "fbb_i2c_oled",
      "default_args": [
        "--socket", "{socket_path}"
      ],
      "ui_widget": {
        "title": "SSD1306 OLED Display (128x64)",
        "board_svg": "board.svg",
        "overlay_offset": {
          "left": "13.25%",
          "top": "20.0%",
          "width": "73.5%",
          "height": "36.75%"
        },
        "controls": [
          { 
            "type": "framebuffer", 
            "name": "display", 
            "width": 128, 
            "height": 64, 
            "format": "mono_page_8",
            "palette": { "bg": "#040604", "fg": "#00ff50" }
          }
        ]
      }
    }
  ]
}
