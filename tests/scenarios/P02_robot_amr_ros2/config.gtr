/dts-v1/;
/include/ "config.dts"

&vfpga_robot_uio {
    registers = 
            "STATUS        @ 0x00 : RO",
            "LEFT_ENCODER  @ 0x04 : RO",
            "RIGHT_ENCODER @ 0x08 : RO",
            "INT_ACK       @ 0x0C : WO",
            "CONTROL       @ 0x10 : RW",
            "LEFT_PWM      @ 0x14 : RW",
            "RIGHT_PWM     @ 0x18 : RW",
            "CYCLE_CNT     @ 0x1C : RO";
};
